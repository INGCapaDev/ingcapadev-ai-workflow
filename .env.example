# Copy to .env for shell-based workflows (this file is tracked, .env is gitignored).
# Note: the OpenCode background service does NOT auto-load .env files.
# `{env:VAR}` in opencode.json resolves from the server process environment,
# so register secrets with:  opencode service set env CONTEXT7_API_KEY <your-key>
CONTEXT7_API_KEY=
