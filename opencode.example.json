{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "ingcapa-dev-orchestrator",
  "shell": "C:/Program Files/Git/bin/bash.exe",
  "agent": {
    "ingcapa-dev-orchestrator": {
      "description": "Capa v3 senior developer - implements, delegates, owns plan state and human transitions",
      "mode": "primary",
      "model": "openai/gpt-6.1-sol",
      "variant": "high",
      "permission": {
        "task": {
          "*": "deny",
          "explore": "allow",
          "capa-worker": "allow",
          "sub-verify": "allow",
          "sub-review-standards": "allow",
          "sub-review-plan": "allow"
        }
      },
      "prompt": "{file:./prompts/capa/orchestrator.md}"
    },
    "capa-worker": {
      "description": "Bounded Capa implementation worker",
      "hidden": true,
      "mode": "subagent",
      "model": "openai/gpt-6.1-sol",
      "variant": "medium",
      "permission": {
        "task": "deny"
      },
      "prompt": "{file:./prompts/capa/worker.md}"
    },
    "sub-verify": {
      "description": "Optional read-only Capa checker",
      "hidden": true,
      "mode": "subagent",
      "model": "openai/gpt-6.1-sol",
      "variant": "medium",
      "permission": {
        "edit": "deny",
        "task": "deny"
      },
      "prompt": "{file:./prompts/capa/checker.md}"
    },
    "sub-review-standards": {
      "description": "Read-only Capa standards review axis",
      "hidden": true,
      "mode": "subagent",
      "model": "openai/gpt-6.1-sol",
      "variant": "high",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      },
      "prompt": "{file:./prompts/capa/review-standards.md}"
    },
    "sub-review-plan": {
      "description": "Read-only Capa plan-conformance review axis",
      "hidden": true,
      "mode": "subagent",
      "model": "openai/gpt-6.1-sol",
      "variant": "high",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      },
      "prompt": "{file:./prompts/capa/review-plan.md}"
    },
    "explore": {
      "model": "openai/gpt-6-luna",
      "variant": "xhigh",
      "permission": {
        "edit": "deny",
        "task": "deny"
      }
    },
    "general": {
      "model": "openai/gpt-6.1-sol",
      "variant": "medium"
    },
    "title": {
      "model": "openai/gpt-6-luna",
      "variant": "medium"
    },
    "summary": {
      "model": "openai/gpt-6.1-sol",
      "variant": "medium"
    }
  },
  "mcp": {
    "context7": {
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "YOUR_CONTEXT7_API_KEY_HERE"
      },
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "engram": {
      "command": [
        "engram",
        "mcp",
        "--tools=agent"
      ],
      "type": "local"
    }
  },
  "permission": {
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git status *": "allow",
      "git branch": "allow",
      "git branch --show-current": "allow",
      "git branch --list": "allow",
      "git branch -vv": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git rev-parse *": "allow",
      "git ls-files": "allow",
      "git ls-files *": "allow",
      "git ls-tree *": "allow",
      "git hash-object --no-filters -- *": "allow",
      "git remote -v": "allow",
      "git stash list": "allow",
      "git stash list *": "allow",
      "git merge-base *": "allow",
      "git check-ignore *": "allow",
      "git rev-list *": "allow",
      "git ls-remote *": "allow",
      "gh repo view --json *": "allow",
      "gh pr list *": "allow",
      "gh pr view *": "allow",
      "gh pr checks *": "allow",
      "gh issue list *": "allow",
      "gh issue view *": "allow",
      "opencode --version": "allow",
      "pwd": "allow",
      "test -e *": "allow",
      "test -f *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "stat *": "allow",
      "sha256sum *": "allow",
      "wc *": "allow",
      "file *": "allow",
      "du *": "allow",
      "df *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "command -v *": "allow",
      "Test-Path *": "allow",
      "Get-ChildItem": "allow",
      "Get-ChildItem *": "allow",
      "Get-Item *": "allow",
      "Get-Location": "allow",
      "Select-String *": "allow",
      "Get-FileHash *": "allow",
      "powershell -NoProfile -NonInteractive -Command 'Test-Path *'": "allow",
      "powershell -NoProfile -NonInteractive -Command 'Get-ChildItem *'": "allow",
      "powershell -NoProfile -NonInteractive -Command 'Get-Item *'": "allow",
      "powershell -NoProfile -NonInteractive -Command 'Get-Location'": "allow",
      "powershell -NoProfile -NonInteractive -Command 'Select-String *'": "allow",
      "powershell -NoProfile -NonInteractive -Command 'Get-FileHash *'": "allow",
      "pwsh -NoProfile -NonInteractive -Command 'Test-Path *'": "allow",
      "pwsh -NoProfile -NonInteractive -Command 'Get-ChildItem *'": "allow",
      "pwsh -NoProfile -NonInteractive -Command 'Get-Item *'": "allow",
      "pwsh -NoProfile -NonInteractive -Command 'Get-Location'": "allow",
      "pwsh -NoProfile -NonInteractive -Command 'Select-String *'": "allow",
      "pwsh -NoProfile -NonInteractive -Command 'Get-FileHash *'": "allow",
      "pnpm lint*": "allow",
      "pnpm run lint*": "allow",
      "pnpm typecheck*": "allow",
      "pnpm run typecheck*": "allow",
      "pnpm type-check*": "allow",
      "pnpm run type-check*": "allow",
      "pnpm format*": "allow",
      "pnpm run format*": "allow",
      "pnpm test*": "allow",
      "pnpm run test*": "allow",
      "npm run lint*": "allow",
      "npm run typecheck*": "allow",
      "npm run type-check*": "allow",
      "npm run format*": "allow",
      "npm test*": "allow",
      "npm run test*": "allow",
      "yarn lint*": "allow",
      "yarn run lint*": "allow",
      "yarn typecheck*": "allow",
      "yarn run typecheck*": "allow",
      "yarn type-check*": "allow",
      "yarn run type-check*": "allow",
      "yarn format*": "allow",
      "yarn run format*": "allow",
      "yarn test*": "allow",
      "yarn run test*": "allow",
      "bun run lint*": "allow",
      "bun run typecheck*": "allow",
      "bun run type-check*": "allow",
      "bun run format*": "allow",
      "bun test*": "allow",
      "bun run test*": "allow",
      "pnpm exec tsc --noEmit*": "allow",
      "pnpm exec eslint *": "allow",
      "pnpm exec prettier *": "allow",
      "pnpm exec biome check *": "allow",
      "pnpm exec biome lint *": "allow",
      "pnpm exec biome format *": "allow",
      "npx --no-install tsc --noEmit*": "allow",
      "npx --no-install eslint *": "allow",
      "npx --no-install prettier *": "allow",
      "tsc --noEmit*": "allow",
      "eslint *": "allow",
      "prettier *": "allow",
      "go test *": "allow",
      "go vet *": "allow",
      "go fmt *": "allow",
      "gofmt *": "allow",
      "ruff check *": "allow",
      "ruff format *": "allow",
      "black *": "allow",
      "mypy *": "allow",
      "pytest": "allow",
      "pytest *": "allow",
      "pnpm *--update*": "ask",
      "pnpm * -u*": "ask",
      "pnpm * -U*": "ask",
      "npm *--update*": "ask",
      "npm * -u*": "ask",
      "npm * -U*": "ask",
      "yarn *--update*": "ask",
      "yarn * -u*": "ask",
      "yarn * -U*": "ask",
      "bun *--update*": "ask",
      "bun * -u*": "ask",
      "bun * -U*": "ask",
      "rg *--pre*": "ask",
      "git *--output*": "ask",
      "git *--ext-diff*": "ask",
      "git *--textconv*": "ask",
      "git *--upload-pack*": "ask",
      "gh *--web*": "ask",
      "git commit*": "ask",
      "git push*": "ask",
      "*;*": "ask",
      "*&*": "ask",
      "*|*": "ask",
      "*>*": "ask",
      "*<*": "ask",
      "*$*": "ask",
      "*`*": "ask",
      "*(*": "ask",
      "* {*": "ask",
      "*\n*": "ask",
      "*\r*": "ask"
    },
    "edit": {
      "*": "ask",
      "C:/Users/YOUR_USERNAME/.config/opencode/**": "ask"
    },
    "external_directory": {
      "*": "ask",
      "C:/Users/YOUR_USERNAME/.config/opencode/**": "allow",
      "C:/path/to/opencode/**": "allow"
    },
    "list": {
      "*": "ask",
      "C:/Users/YOUR_USERNAME/.config/opencode/**": "allow",
      "C:/path/to/opencode/**": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "C:/Users/YOUR_USERNAME/.config/opencode/**": "allow",
      "C:/path/to/opencode/**": "allow"
    }
  },
  "provider": {
    "google": {
      "options": {
        "projectId": "YOUR_GOOGLE_CLOUD_PROJECT_ID"
      }
    }
  },
  "plugin": [
    "opencode-gemini-auth@latest"
  ]
}
