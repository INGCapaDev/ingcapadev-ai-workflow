{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "ingcapa-dev-orchestrator",
  "shell": "C:/Program Files/Git/bin/bash.exe",
  "providers": {
    "openai": {
      "models": {
        "gpt-6.1-sol": {
          "limit": {
            "context": 450000
          }
        },
        "gpt-6-luna": {
          "limit": {
            "context": 450000
          }
        }
      }
    }
  },
  "agents": {
    "ingcapa-dev-orchestrator": {
      "description": "Capa v3 senior developer - implements, delegates, owns plan state and human transitions",
      "mode": "primary",
      "model": "openai/gpt-6.1-sol#medium",
      "system": "{file:./prompts/capa/orchestrator.md}",
      "permissions": [
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "explore",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "capa-worker",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "sub-verify",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "sub-review-standards",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "sub-review-plan",
          "effect": "allow"
        }
      ]
    },
    "capa-worker": {
      "description": "Bounded Capa implementation worker",
      "mode": "subagent",
      "model": "openai/gpt-6.1-sol#medium",
      "system": "{file:./prompts/capa/worker.md}",
      "permissions": [
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "sub-verify": {
      "description": "Optional read-only Capa checker",
      "mode": "subagent",
      "model": "openai/gpt-6.1-sol#medium",
      "system": "{file:./prompts/capa/checker.md}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "sub-review-standards": {
      "description": "Read-only Capa standards review axis",
      "mode": "subagent",
      "model": "openai/gpt-6.1-sol#medium",
      "system": "{file:./prompts/capa/review-standards.md}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "sub-review-plan": {
      "description": "Read-only Capa plan-conformance review axis",
      "mode": "subagent",
      "model": "openai/gpt-6.1-sol#medium",
      "system": "{file:./prompts/capa/review-plan.md}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "explore": {
      "model": "openai/gpt-6-luna#xhigh",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "general": {
      "model": "openai/gpt-6.1-sol#medium"
    },
    "title": {
      "model": "openai/gpt-6-luna#medium"
    },
    "summary": {
      "model": "openai/gpt-6.1-sol#low"
    }
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        },
        "oauth": false
      },
      "engram": {
        "type": "local",
        "command": [
          "engram",
          "mcp",
          "--tools=agent"
        ]
      }
    }
  },
