{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "ingcapa-dev-orchestrator",
  "shell": "C:/Program Files/Git/bin/bash.exe",
  "agent": {
    "ingcapa-dev-orchestrator": {
      "description": "Capa v3 senior developer - implements, delegates, owns plan state and human transitions",
      "mode": "primary",
      "model": "openai/gpt-6.1-sol",
      "variant": "high",
      "permission": {
        "task": {
          "*": "deny",
          "explore": "allow",
          "capa-worker": "allow",
          "sub-verify": "allow",
          "sub-review-standards": "allow",
          "sub-review-plan": "allow"
        }
      },
      "prompt": "{file:./prompts/capa/orchestrator.md}"
    },
    "capa-worker": {
      "description": "Bounded Capa implementation worker",
      "hidden": true,
      "mode": "subagent",
      "model": "openai/gpt-6.1-sol",
      "variant": "medium",
      "permission": {
        "task": "deny"
      },
      "prompt": "{file:./prompts/capa/worker.md}"
    },
    "sub-verify": {
      "description": "Optional read-only Capa checker",
      "hidden": true,
      "mode": "subagent",
      "model": "openai/gpt-6.1-sol",
      "variant": "medium",
      "permission": {
        "edit": "deny",
        "task": "deny"
      },
      "prompt": "{file:./prompts/capa/checker.md}"
    },
    "sub-review-standards": {
      "description": "Read-only Capa standards review axis",
      "hidden": true,
      "mode": "subagent",
      "model": "openai/gpt-6.1-sol",
      "variant": "high",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      },
      "prompt": "{file:./prompts/capa/review-standards.md}"
    },
    "sub-review-plan": {
      "description": "Read-only Capa plan-conformance review axis",
      "hidden": true,
      "mode": "subagent",
      "model": "openai/gpt-6.1-sol",
      "variant": "high",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      },
      "prompt": "{file:./prompts/capa/review-plan.md}"
    },
    "explore": {
      "model": "openai/gpt-6-luna",
      "variant": "xhigh",
      "permission": {
        "edit": "deny",
        "task": "deny"
      }
    },
    "general": {
      "model": "openai/gpt-6.1-sol",
      "variant": "medium"
    },
    "title": {
      "model": "openai/gpt-6-luna",
      "variant": "medium"
    },
    "summary": {
      "model": "openai/gpt-6.1-sol",
      "variant": "medium"
    }
  },
  "mcp": {
    "context7": {
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "YOUR_CONTEXT7_API_KEY_HERE"
      },
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "engram": {
      "command": [
        "engram",
        "mcp",
        "--tools=agent"
      ],
      "type": "local"
    }
  },
  "permission": {
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git branch": "allow",
      "git branch --show-current": "allow",
      "git branch --list": "allow",
      "git branch -vv": "allow",
      "git diff --no-ext-diff --no-textconv *": "allow",
      "git log --oneline": "allow",
      "git log --oneline -5": "allow",
      "git log --oneline -10": "allow",
      "git log --oneline -12": "allow",
      "git log --no-ext-diff --no-textconv *": "allow",
      "git show --no-ext-diff --no-textconv *": "allow",
      "git rev-parse*": "allow",
      "git ls-files*": "allow",
      "git ls-tree*": "allow",
      "git remote -v": "allow",
      "git stash list*": "allow",
      "git merge-base *": "allow",
      "git check-ignore *": "allow",
      "git rev-list --count *": "allow",
      "git ls-remote --heads origin": "allow",
      "git ls-remote --heads origin *": "allow",
      "gh repo view --json *": "allow",
      "gh pr list *": "allow",
      "gh pr view *": "allow",
      "gh pr checks *": "allow",
      "opencode --version": "allow",
      "pwd": "allow",
      "test -e *": "allow",
      "test -f *": "allow",
      "ls -la": "allow",
      "ls -ld -- *": "allow",
      "stat -- *": "allow",
      "sha256sum -- *": "allow",
      "command -v *": "allow",
      "pnpm lint": "allow",
      "pnpm lint *": "allow",
      "pnpm run lint": "allow",
      "pnpm run lint *": "allow",
      "pnpm typecheck": "allow",
      "pnpm typecheck *": "allow",
      "pnpm run typecheck": "allow",
      "pnpm run typecheck *": "allow",
      "pnpm test": "allow",
      "pnpm test *": "allow",
      "pnpm run test": "allow",
      "pnpm run test *": "allow",
      "pnpm exec tsc --noEmit*": "allow",
      "pnpm *--fix*": "ask",
      "pnpm *--update*": "ask",
      "pnpm * -u*": "ask",
      "pnpm * -U*": "ask",
      "git *--output*": "ask",
      "git *--ext-diff*": "ask",
      "git *--textconv*": "ask",
      "git *--upload-pack*": "ask",
      "gh *--web*": "ask",
      "git commit*": "ask",
      "git push*": "ask",
      "*;*": "ask",
      "*&*": "ask",
      "*|*": "ask",
      "*>*": "ask",
      "*<*": "ask",
      "*$*": "ask",
      "*`*": "ask",
      "*(*": "ask",
      "* {*": "ask",
      "*\n*": "ask",
      "*\r*": "ask"
    },
    "edit": {
      "*": "ask",
      "C:/Users/YOUR_USERNAME/.config/opencode/**": "ask"
    },
    "external_directory": {
      "*": "ask",
      "C:/Users/YOUR_USERNAME/.config/opencode/**": "allow",
      "C:/path/to/opencode/**": "allow"
    },
    "list": {
      "*": "ask",
      "C:/Users/YOUR_USERNAME/.config/opencode/**": "allow",
      "C:/path/to/opencode/**": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "C:/Users/YOUR_USERNAME/.config/opencode/**": "allow",
      "C:/path/to/opencode/**": "allow"
    }
  },
  "provider": {
    "google": {
      "options": {
        "projectId": "YOUR_GOOGLE_CLOUD_PROJECT_ID"
      }
    }
  },
  "plugin": [
    "opencode-gemini-auth@latest"
  ]
}
