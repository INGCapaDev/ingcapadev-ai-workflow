{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "ingcapa-dev-orchestrator": {
      "description": "INGCapaDev Orchestrator - classifies, routes, delegates, owns handoff state",
      "mode": "primary",
      "model": "openai/gpt-5.6-sol",
      "variant": "medium",
      "permission": {
        "task": {
          "*": "deny",
          "sub-explore": "allow",
          "sub-apply": "allow",
          "sub-verify": "allow",
          "sub-review-standards": "allow",
          "sub-review-plan": "allow"
        }
      },
      "prompt": "{file:./prompts/capa/orchestrator.md}"
    },
    "sub-explore": {
      "description": "Read-only Capa exploration specialist",
      "hidden": true,
      "mode": "subagent",
      "model": "openai/gpt-5.6-terra",
      "variant": "medium",
      "permission": {
        "edit": "deny",
        "task": "deny"
      },
      "prompt": "{file:./prompts/capa/sub-explore.md}"
    },
    "sub-apply": {
      "description": "One approved Capa implementation slice",
      "hidden": true,
      "mode": "subagent",
      "model": "openai/gpt-5.6-sol",
      "variant": "low",
      "permission": {
        "task": "deny"
      },
      "prompt": "{file:./prompts/capa/sub-apply.md}"
    },
    "sub-verify": {
      "description": "Read-only Capa verification specialist",
      "hidden": true,
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna",
      "variant": "max",
      "permission": {
        "edit": "deny",
        "task": "deny"
      },
      "prompt": "{file:./prompts/capa/sub-verify.md}"
    },
    "sub-review-standards": {
      "description": "Read-only Capa standards review axis",
      "hidden": true,
      "mode": "subagent",
      "model": "openai/gpt-5.6-sol",
      "variant": "medium",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      },
      "prompt": "{file:./prompts/capa/sub-review-standards.md}"
    },
    "sub-review-plan": {
      "description": "Read-only Capa plan-conformance review axis",
      "hidden": true,
      "mode": "subagent",
      "model": "openai/gpt-5.6-sol",
      "variant": "medium",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      },
      "prompt": "{file:./prompts/capa/sub-review-plan.md}"
    },
    "explore": {
      "model": "openai/gpt-5.6-luna",
      "variant": "xhigh"
    },
    "general": {
      "model": "opencode/deepseek-v4-flash-free",
      "variant": "max"
    },
    "title": {
      "model": "opencode/deepseek-v4-flash-free"
    },
    "summary": {
      "model": "opencode/deepseek-v4-flash-free"
    }
  },
  "mcp": {
    "context7": {
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "YOUR_CONTEXT7_API_KEY_HERE"
      },
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "engram": {
      "command": [
        "engram",
        "mcp",
        "--tools=agent"
      ],
      "type": "local"
    }
  },
  "permission": {
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git branch*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git rev-parse*": "allow",
      "git ls-files*": "allow",
      "git ls-tree*": "allow",
      "git config --get*": "allow",
      "git remote -v*": "allow",
      "git stash list*": "allow",
      "Test-Path*": "allow",
      "Get-ChildItem*": "allow",
      "Get-Item*": "allow",
      "Get-Content*": "allow",
      "Get-Command*": "allow",
      "Select-String*": "allow",
      "pnpm lint": "allow",
      "pnpm lint *": "allow",
      "pnpm run lint": "allow",
      "pnpm run lint *": "allow",
      "pnpm typecheck": "allow",
      "pnpm typecheck *": "allow",
      "pnpm run typecheck": "allow",
      "pnpm run typecheck *": "allow",
      "pnpm test": "allow",
      "pnpm test *": "allow",
      "pnpm run test": "allow",
      "pnpm run test *": "allow",
      "pnpm exec tsc --noEmit*": "allow",
      "pnpm *--fix*": "ask",
      "git commit*": "ask",
      "git push*": "ask"
    },
    "edit": {
      "*": "ask",
      "C:/Users/YOUR_USERNAME/.config/opencode/**": "ask"
    },
    "external_directory": {
      "*": "ask",
      "C:/Users/YOUR_USERNAME/.config/opencode/**": "allow",
      "C:/path/to/opencode/**": "allow"
    },
    "list": {
      "*": "ask",
      "C:/Users/YOUR_USERNAME/.config/opencode/**": "allow",
      "C:/path/to/opencode/**": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "C:/Users/YOUR_USERNAME/.config/opencode/**": "allow",
      "C:/path/to/opencode/**": "allow"
    }
  },
  "provider": {
    "google": {
      "options": {
        "projectId": "YOUR_GOOGLE_CLOUD_PROJECT_ID"
      }
    }
  },
  "plugin": [
    "opencode-gemini-auth@latest"
  ]
}
